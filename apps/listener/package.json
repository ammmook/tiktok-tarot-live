  "dependencies": {
    "@tarot-live/shared": "workspace:*",
    "dotenv": "17.2.2",
    "tiktok-live-connector": "2.5.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "eslint": "^9",
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}
