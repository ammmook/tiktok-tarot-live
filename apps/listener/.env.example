# Enter the TikTok username on the dashboard and press Connect.
# Public LIVE reading works without TikTok cookies or an Euler paid plan.
TIKTOK_SESSION_ID=
TIKTOK_TT_TARGET_IDC=
TIKTOK_AUTHENTICATE_WS=false
# Leave these blank/false unless you deliberately use a paid signing provider.
TIKTOK_SIGN_API_KEY=
TIKTOK_TRUST_SIGNING_SERVICE=false
API_BASE_URL=http://localhost:4000
LISTENER_SECRET=replace-with-the-same-secret-as-API
LISTENER_INSTANCE_ID=tarot-listener-1
LISTENER_HEARTBEAT_SECONDS=25
LISTENER_RETRY_BUFFER_CAPACITY=1000
TIKTOK_MAX_EVENT_AGE_MS=30000
